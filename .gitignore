# ==============================================================================
# DRC Smart POS — Unified .gitignore
# ==============================================================================

# --- Environment variables & Credentials ---
.env
.env.*
*.env
*.secret
*.pem
*.key
*.cert
credentials.json
secrets.yaml
secrets.yml

# --- SQLite & Database Files ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
drc_smart_pos.db
backend/drc_smart_pos.db

# --- Markdown Documentation (Ignore all .md files except README.md) ---
*.md
**/*.md
!README.md
!**/README.md

# --- Python & Virtual Environments ---
.venv/
.venv*/
backend/.venv/
env/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
backend/**/__pycache__/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# --- Node.js, Frontend & Bundled Binaries ---
node_bin/
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# --- IDE, Editors & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
